    %% =====================================================
    %% TOOLKIT-TO-USE-CASE CONNECTIONS
    %% =====================================================

    AUTHOR -. "defines" .-> CONFIG
    AUTHOR -. "models" .-> DEPLOY
    AUTHOR -. "coordinates" .-> ORCHESTRATE

    EXECUTE -. "runs automation" .-> CONFIG
    EXECUTE -. "executes deployments" .-> DEPLOY
    EXECUTE -. "performs maintenance" .-> OPERATIONS

    CONTENT -. "provides reusable content" .-> PROVISION
    CONTENT -. "provides integrations" .-> CLOUD_AUTO
    CONTENT -. "provides device modules" .-> NETWORK_AUTO

    TEST -. "validates" .-> CONFIG
    TEST -. "tests deployments" .-> DEPLOY
    TEST -. "checks compliance" .-> SECURITY_AUTO

    SECURE -. "protects credentials" .-> SECURITY_AUTO
    SECURE -. "controls privileges" .-> OPERATIONS

    PLATFORM -. "governs" .-> ORCHESTRATE
    PLATFORM -. "scales" .-> CLOUD_AUTO
    PLATFORM -. "responds to events" .-> OPERATIONS

    INTEGRATE -. "targets resources" .-> PROVISION
    INTEGRATE -. "connects providers" .-> CLOUD_AUTO
    INTEGRATE -. "connects devices" .-> NETWORK_AUTO

